{
  "name": "subscription-management-system",
  "version": "0.1.0",
  "private": true,
  "description": "Subscription Management System - Monorepo architecture for modern SaaS billing",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"magenta,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "start:backend": "npm --prefix backend start",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm --prefix frontend run build",
    "db:init": "npm --prefix backend run db:init",
    "admin:create": "npm --prefix backend run admin:create",
    "test:backend": "node backend/test_api_integration.js",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
