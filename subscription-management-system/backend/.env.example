# ==============================================================================
# ZYLO STREAM: Backend Environment Configuration
# Copy this file to .env and configure your local credentials
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Client URL (for CORS and cookie origin)
CLIENT_URL=http://localhost:5173

# Supabase PostgreSQL (preferred for deployed environments)
# Get the connection string from Supabase Dashboard > Project Settings > Database.
# Use the Supavisor transaction pooler connection string for serverless deployments.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:6543/postgres?sslmode=require
DB_POOL_MAX=10

# Optional local MySQL fallback (used only when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=zylo_stream

# JWT Authentication Secret
JWT_SECRET=zylo_stream_jwt_super_secret_key_change_in_production_2026!
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 Credentials (Optional / Integration Points)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
